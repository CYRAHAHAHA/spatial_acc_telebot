# Example Environment Variables for Railway Deployment

# Copy this file and configure for your deployment
# DO NOT commit the actual .env file to git!

# =============================================================================
# AUTODESK CONSTRUCTION CLOUD (ACC) CREDENTIALS
# =============================================================================
# Get these from: https://aps.autodesk.com/
CLIENT_ID=your_autodesk_client_id_here
CLIENT_SECRET=your_autodesk_client_secret_here

# OAuth Callback URL - UPDATE after first Railway deployment
# Format: https://your-app-name.up.railway.app/callback
REDIRECT_URI=https://your-railway-app.up.railway.app/callback

# API Scopes (required for ACC access)
SCOPES=data:read data:write data:create

# Your ACC Project ID (format: b.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
PROJECT_ID=your_acc_project_id_here

# =============================================================================
# TELEGRAM BOT CONFIGURATION
# =============================================================================
# Get token from: https://t.me/botfather
TELEGRAM_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz1234567890

# =============================================================================
# RAILWAY AUTO-INJECTED VARIABLES (Do not set manually)
# =============================================================================
# Railway automatically provides these - don't set them yourself:
# PORT=<auto-assigned>                      - Service port
# RAILWAY_ENVIRONMENT=production            - Environment name
# RAILWAY_PUBLIC_DOMAIN=<auto>.railway.app  - Public domain
# RAILWAY_STATIC_URL=https://<auto>         - Static URL
# RAILWAY_PROJECT_ID=<auto>                 - Project ID
# RAILWAY_SERVICE_ID=<auto>                 - Service ID
# RAILWAY_PROJECT_NAME=<auto>               - Project name
# RAILWAY_SERVICE_NAME=<auto>               - Service name

# =============================================================================
# LEGACY VARIABLES (EC2 deployment only, not needed for Railway)
# =============================================================================
# These were used for EC2 deployment and are now handled by Railway:
# YR_CLIENT_ID          - Use CLIENT_ID instead
# YR_CLIENT_SECRET      - Use CLIENT_SECRET instead
# YR_REDIRECT_URI       - Use REDIRECT_URI instead
# YR_SCOPES             - Use SCOPES instead
# YR_PROJECT_ID         - Use PROJECT_ID instead
# SITE_UPDATES_TOKEN    - Not needed for Railway
# FLASK_BASE            - Use FLASK_API_URL instead

# =============================================================================
# DEVELOPMENT / TESTING OVERRIDES
# =============================================================================
# For local development, you can override Railway variables:
# PORT=8080                          - Local development port
# RAILWAY_ENVIRONMENT=development    - Mark as dev environment
# FLASK_API_URL=http://localhost:8080  - Local Flask API

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
# 1. Create Autodesk APS app: https://aps.autodesk.com/
# 2. Create Telegram bot: https://t.me/botfather
# 3. Copy this file to .env (local) or add to Railway dashboard
# 4. Fill in your credentials
# 5. After first Railway deploy, update REDIRECT_URI with your Railway URL
# 6. Update Autodesk APS callback URL to match REDIRECT_URI
# 7. Deploy again (Railway auto-redeploys on env var changes)

# =============================================================================
# SECURITY NOTES
# =============================================================================
# ⚠️  NEVER commit .env file to git
# ⚠️  Add .env to .gitignore
# ⚠️  Use Railway's UI for production secrets
# ⚠️  Rotate tokens regularly
# ⚠️  Enable 2FA on Railway and Autodesk accounts
